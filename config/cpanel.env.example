APP_NAME=Plataforma de Gestao de Torneios MVP
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.cassianogalvao.com.br/torneio-online
APP_BASE_PATH=/torneio-online
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=localhost
DB_PORT=3306
DB_NAME=xdigcomb_torneio-online
DB_USER=xdigcomb_torneio-online-user
DB_PASS=COLE_A_SENHA_NOVA_DO_BANCO_AQUI

SESSION_NAME=torneios_mvp_session
SESSION_TIMEOUT=1800
SESSION_SAVE_PATH=storage/sessions
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax
APP_KEY=COLE_A_CHAVE_BASE64_GERADA_AQUI
APP_HSTS=true

AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_MINUTES=15
AUTH_LOCK_SECONDS=900
MAIL_TRANSPORT=log
SEED_DEMO_PASSWORD=
BACKUP_DIR=storage/backups
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
