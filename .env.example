APP_NAME=Torneio Online Web App
APP_ENV=development
APP_DEBUG=false
APP_URL=https://www.cassianogalvao.com.br/torneio-online
APP_BASE_PATH=/torneio-online
APP_TIMEZONE=America/Sao_Paulo
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=torneios_mvp
DB_USER=root
DB_PASS=
SESSION_NAME=torneios_mvp_session
SESSION_TIMEOUT=1800
SESSION_SAVE_PATH=storage/sessions
SESSION_SECURE_COOKIE=false
SESSION_SAMESITE=Lax
APP_KEY=base64:generate-a-32-byte-key-for-each-environment
APP_HSTS=false
IMAGE_UPLOAD_MAX_BYTES=12582912
IMAGE_UPLOAD_MAX_PIXELS=50000000
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_MINUTES=15
AUTH_LOCK_SECONDS=900
MAIL_TRANSPORT=log
SEED_DEMO_PASSWORD=ChangeMeOnlyInDevelopment123
BACKUP_DIR=storage/backups
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
BACKUP_ENABLED=true
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=14
BACKUP_STORAGE_PROVIDER=local
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ACCESS_TOKEN=
BACKUP_SCHEDULE_CRON=*/5 * * * *
